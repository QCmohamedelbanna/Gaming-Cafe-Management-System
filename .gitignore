# Build output
backend/target/
frontend/dist/
frontend/node_modules/
.mvn-node/
frontend/.mvn-node/
target/

# Local database
*.db
*.db-journal

# Environment overrides (never commit real secrets/URLs)
.env
.env.*
!.env.example
!.env.*.example
.env.local
.env.*.local

# External production configuration when a local checkout is used for
# packaged-runtime smoke testing. The real client file lives under ProgramData.
config/gaming-cafe.properties
backend/config/gaming-cafe.properties

# Locally cached credentials/tokens, if a provider or developer tool writes them
*.token
.tokens/

# Runtime logs, database backups, and private key material
backend/logs/
logs/
backend/backup/
backup/
**/gaming-cafe.lock
backups/
*.sql.gz
*.pem
*.key
*.p12

# IDE
.idea/

# OS
.DS_Store
Thumbs.db
