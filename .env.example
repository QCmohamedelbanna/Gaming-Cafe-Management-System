# Optional developer overrides. Copy this file to .env only for local work;
# the installed client reads its database and log locations from ProgramData
# and does not need this file.

# Development SQLite file. Relative paths are resolved from backend/.
GAMING_CAFE_DEV_DB_PATH=ps_cafe.db

# First administrator created in a new development database.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=__REPLACE_ME_LOCAL_ADMIN_PASSWORD__

# Optional cross-origin development frontend override.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# The normal Vite build uses the same-origin API path.
VITE_API_URL=/api

# Optional dedicated MySQL database used only by backend integration tests.
# Never point these values at a development or client database.
TEST_DB_URL=jdbc:mysql://127.0.0.1:3306/ps_cafe_test?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
TEST_DB_USER=__REPLACE_ME_TEST_DB_USER__
TEST_DB_PASSWORD=__REPLACE_ME_TEST_DB_PASSWORD__

# Optional Tuya Cloud PoC. Leave disabled in development unless using the
# phone-charger test load. Credentials stay in the backend environment only.
DEVICE_CONTROL_MODE=mock
TUYA_ENABLED=false
TUYA_ENDPOINT=https://openapi.tuyaus.com
TUYA_CLIENT_ID=
TUYA_CLIENT_SECRET=
TUYA_CONNECT_TIMEOUT=2s
TUYA_REQUEST_TIMEOUT=5s
TUYA_MAX_ATTEMPTS=2
